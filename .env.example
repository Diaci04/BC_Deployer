# ------------------------------------------------------------------ obbligatorie
# Hash argon2 della password admin:  python -m app.cli hash-password
# Tra apici singoli: l'hash contiene "$" e docker compose lo interpreterebbe.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'

# Chiave/i Fernet per cifrare i client secret:  python -m app.cli gen-key
# Più chiavi separate da virgola: la prima cifra, tutte decifrano (rotazione).
# Se la perdi, i secret salvati non sono più leggibili: conservala in un vault.
FERNET_KEYS=

# ------------------------------------------------------------------ opzionali
# production (default): HTTPS obbligatorio + HSTS. development: niente redirect.
APP_ENV=production
ADMIN_USERNAME=admin

# Cartella dati persistente (DB SQLite + .app caricati). Nel container: /data
DATA_DIR=/data
# Vuoto = SQLite in DATA_DIR. Per Postgres basta la connection string:
# DATABASE_URL=postgresql+psycopg://utente:password@host:5432/bcdeployer?sslmode=require
DATABASE_URL=
# SQLite su file system di rete (Azure App Service /home, Azure Files): DELETE. Disco locale/volume: WAL
SQLITE_JOURNAL_MODE=WAL

# URL pubblico dell'app, per i link nelle notifiche webhook
PUBLIC_BASE_URL=

# Sessione
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
COOKIE_SECURE=true

# Limite ai tentativi di login falliti per IP nella finestra
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Upload e deploy
MAX_APP_SIZE_MB=100
UPLOAD_RETENTION_DAYS=7
TIMEZONE=Europe/Rome
BC_TIMEOUT=60
BC_UPLOAD_TIMEOUT=900
# Minuti massimi di attesa dell'esito di installazione per ogni app
APP_TIMEOUT_MINUTES=60
# Se il servizio era spento all'ora prevista di un job, lo esegue comunque entro questo margine
SCHEDULER_MISFIRE_GRACE_MINUTES=60

# Porta di ascolto nel container (Azure App Service: imposta anche WEBSITES_PORT)
PORT=8000
